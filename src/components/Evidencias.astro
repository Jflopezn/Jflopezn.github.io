
---
import { evidencias } from "../data/evidencias";

const base = import.meta.env.BASE_URL;
---

<section
    id="evidencias"
    class="min-h-screen py-16 bg-gray-50 dark:bg-gray-900"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <header class="text-center mb-14">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-5">
                Evidencias
            </h1>

            <p class="max-w-2xl mx-auto text-gray-600 dark:text-gray-400 text-lg">
                Trabajos, actividades y proyectos desarrollados durante mi formación académica.
            </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            {evidencias.map((evidencia) => (
                <article
                    class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden flex flex-col border border-gray-200 dark:border-gray-700 hover:shadow-xl transition-shadow"
                >
                    <a
                        href={`${base}evidencias/${evidencia.slug}/`}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Consultar ${evidencia.titulo}`}
                        class="block"
                    >
                        <div class="h-72 md:h-80 bg-gray-100 dark:bg-gray-700 flex items-center justify-center overflow-hidden">
                            <img
                                src={`${base}${evidencia.imagen}`}
                                alt={evidencia.imagenAlt}
                                loading="lazy"
                                class="w-full h-full object-contain p-3 hover:scale-105 transition-transform duration-300"
                            />
                        </div>
                    </a>

                    <div class="p-6 flex flex-col flex-grow">

                        <span class="text-sm font-semibold text-blue-600 dark:text-blue-400 mb-3">
                            {evidencia.categoria}
                        </span>

                        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-3">
                            {evidencia.titulo}
                        </h2>

                        <p class="text-gray-600 dark:text-gray-300 mb-6 flex-grow">
                            {evidencia.descripcion}
                        </p>

                        <a
                            href={`${base}evidencias/${evidencia.slug}/`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 rounded-lg bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-900 font-semibold hover:opacity-80 transition-opacity"
                        >
                            Ver detalles
                            <span aria-hidden="true">↗</span>
                        </a>

                    </div>
                </article>
            ))}

        </div>
    </div>
</section>
