
---
import Layout from "../../layouts/Layout.astro";
import { evidencias } from "../../data/evidencias";

export function getStaticPaths() {
    return evidencias.map((evidencia) => ({
        params: {
            slug: evidencia.slug
        },
        props: {
            evidencia
        }
    }));
}

const { evidencia } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={evidencia.titulo}>

    <main class="min-h-screen bg-gray-50 dark:bg-gray-900 py-16">

        <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Navegación -->
            <a
                href={`${base}evidencias/`}
                class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:underline mb-10"
            >
                ← Volver a evidencias
            </a>

            <!-- Encabezado -->
            <header class="mb-10">

                <span class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
                    {evidencia.categoria}
                </span>

                <h1 class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-gray-100 mt-3 mb-5">
                    {evidencia.titulo}
                </h1>

                <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl">
                    {evidencia.descripcion}
                </p>

            </header>

            <!-- Imagen principal -->
            <figure class="mb-12 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">

                <div class="min-h-64 p-3 md:p-6 flex items-center justify-center">
                    <img
                        src={`${base}${evidencia.imagen}`}
                        alt={evidencia.imagenAlt}
                        class="max-w-full max-h-[85vh] w-auto h-auto object-contain"
                    />
                </div>

                <figcaption class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400 border-t border-gray-200 dark:border-gray-700">
                    {evidencia.imagenAlt}
                </figcaption>

            </figure>

            <!-- Contexto -->
            <section class="mb-10">

                <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">
                    Contexto de la actividad
                </h2>

                <p class="text-gray-700 dark:text-gray-300 leading-8">
                    {evidencia.contexto}
                </p>

            </section>

            <!-- Desarrollo -->
            <section class="mb-10">

                <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">
                    Desarrollo del trabajo
                </h2>

                <p class="text-gray-700 dark:text-gray-300 leading-8">
                    {evidencia.desarrollo}
                </p>

            </section>

            <!-- Aprendizajes -->
            <section class="mb-12">

                <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-5">
                    Conocimientos aplicados
                </h2>

                <ul class="space-y-3">

                    {evidencia.aprendizajes.map((aprendizaje) => (
                        <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
                            <span class="text-blue-600 dark:text-blue-400 font-bold">
                                ✓
                            </span>
                            <span>{aprendizaje}</span>
                        </li>
                    ))}

                </ul>

            </section>

            <!-- Volver -->
            <footer class="border-t border-gray-200 dark:border-gray-700 pt-8">

                <a
                    href={`${base}evidencias/`}
                    class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-900 font-semibold hover:opacity-80 transition-opacity"
                >
                    ← Volver a todas las evidencias
                </a>

            </footer>

        </article>

    </main>

</Layout>
